// ============================================================================
// 33 — TRAITEMENT D’UN SUJET
// ============================================================================

function traiterSujet_(page) {
  const radar =
    readRadar_(page);

  Logger.log(
    'TRAITEMENT : ' +
    radar.nom
  );

  let dossier =
    trouverDossierParNom_(radar);

  if (!dossier) {
    dossier =
      creerDossier_(radar);
  }

  if (
    dossierDocumente_(dossier)
  ) {
    Logger.log(
      'Dossier déjà documenté : ' +
      radar.nom
    );

    uncheckRechercheDocumentaire_(
      page
    );

    return dossier;
  }

  const texteRecherche =
    [
      radar.nom,
      radar.sujet,
      radar.taxon,
      radar.resume,
      radar.notes
    ]
      .filter(Boolean)
      .join(' ');

  const espece =
    extraireEspece_(
      texteRecherche
    );

  const genre =
    extraireGenre_(
      radar.taxon ||
      texteRecherche
    );

  Logger.log(
    'Espèce détectée : ' +
    (espece || 'aucune')
  );

  Logger.log(
    'Genre détecté : ' +
    (genre || 'aucun')
  );

  const requetes =
    construireRequetes_(
      radar
    );

  let sources = [];

  for (const requete of requetes) {
    sources =
      sources.concat(
        rechercherCrossref_(
          requete
        )
      );

    // Recherche additionnelle ciblée sur Neotropical Ichthyology.
    sources =
      sources.concat(
        rechercherNeotropicalIchthyology_(
          requete
        )
      );

    sources =
      sources.concat(
        rechercherWikimedia_(
          requete
        )
      );
  }

  if (radar.taxon) {
    sources =
      sources.concat(
        rechercherGBIF_(
          radar.taxon
        )
      );
  }

  sources =
    dedoublonnerSources_(
      sources
    );

  const sourcesClassees =
    sources.map(
      source => ({
        source: source,
        classification:
          classifierSource_(
            source,
            radar
          )
      })
    );

  sourcesClassees.sort(
    (a, b) =>
      b.classification.niveau -
      a.classification.niveau
  );

  const selection =
    sourcesClassees.slice(
      0,
      CONFIG.MAX_SOURCES
    );

  const blocs = [];

  blocs.push(
    heading2_(
      'Recherche documentaire automatique'
    )
  );

  blocs.push(
    paragraph_(
      'Date de recherche : ' +
      today_()
    )
  );

  blocs.push(
    paragraph_(
      'Espèce détectée : ' +
      (espece || 'non déterminée')
    )
  );

  blocs.push(
    paragraph_(
      'Genre détecté : ' +
      (genre || 'non déterminé')
    )
  );

  blocs.push(
    paragraph_(
      'Nouvelle espèce : ' +
      (
        detecterNouvelleEspece_(
          texteRecherche
        )
          ? 'oui'
          : 'non déterminé'
      )
    )
  );

  blocs.push(
    heading2_(
      'Sources'
    )
  );

  if (!selection.length) {
    blocs.push(
      paragraph_(
        'Aucune source exploitable trouvée automatiquement.'
      )
    );
  }

  for (const item of selection) {
    blocs.push(
      paragraph_(
        formaterSource_(
          item.source,
          item.classification
        )
      )
    );
  }

  appendBlocks_(
    dossier.id,
    blocs
  );

  uncheckRechercheDocumentaire_(
    page
  );

  Logger.log(
    'Recherche documentaire terminée : ' +
    radar.nom
  );

  return dossier;
}


// ============================================================================
// 34 — MOTEUR PRINCIPAL
// ============================================================================

function lancerMoteurDocumentaire() {
  Logger.log(
    '========================================'
  );

  Logger.log(
    'PASSONS AU VERT — MOTEUR DOCUMENTAIRE'
  );

  Logger.log(
    '========================================'
  );

  const pages =
    getRadarPages_();

  let traites = 0;

  for (const page of pages) {
    const radar =
      readRadar_(page);

    if (!radar.recherche) {
      continue;
    }

    try {
      traiterSujet_(page);
      traites++;
    } catch (e) {
      Logger.log(
        'ERREUR : ' +
        radar.nom +
        ' → ' +
        e.message
      );
    }
  }

  purgeRadar61Jours_();

  Logger.log(
    'Sujets traités : ' +
    traites
  );

  Logger.log(
    'FIN DU MOTEUR DOCUMENTAIRE'
  );
}


// ============================================================================
// 35 — PURGE À 61 JOURS
// ============================================================================

function purgeRadar61Jours_() {
  const pages =
    getRadarPages_();

  const maintenant =
    new Date();

  const seuil =
    CONFIG.PURGE_AFTER_DAYS *
    24 *
    60 *
    60 *
    1000;

  for (const page of pages) {
    const radar =
      readRadar_(page);

    if (radar.sujetRetenu) {
      continue;
    }

    const dateEntree =
      radar.dateDetection
        ? new Date(
            radar.dateDetection
          )
        : new Date(
            radar.createdTime
          );

    if (
      isNaN(
        dateEntree.getTime()
      )
    ) {
      continue;
    }

    if (
      maintenant.getTime() -
      dateEntree.getTime() >=
      seuil
    ) {
      Logger.log(
        'ARCHIVAGE RADAR — 61 JOURS : ' +
        radar.nom
      );

      archiverPage_(
        page.id
      );
    }
  }
}


