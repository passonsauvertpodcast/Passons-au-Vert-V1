// ============================================================================
// 43 — LECTURE PAGINÉE DES BLOCS
// ============================================================================

function transfert35_blocks_(pageId) {
  const results = [];
  let cursor = null;

  while (true) {
    let path =
      '/blocks/' +
      pageId +
      '/children?page_size=100';

    if (cursor) {
      path +=
        '&start_cursor=' +
        encodeURIComponent(
          cursor
        );
    }

    const response =
      notionRequest_(
        'get',
        path
      );

    if (response.results) {
      results.push.apply(
        results,
        response.results
      );
    }

    if (
      !response.has_more ||
      !response.next_cursor
    ) {
      break;
    }

    cursor =
      response.next_cursor;
  }

  return results;
}


// ============================================================================
// 44 — EXTRACTION TEXTE DES BLOCS
// ============================================================================

function transfert35_blockText_(block) {
  if (!block) {
    return '';
  }

  const type =
    block.type;

  if (!type || !block[type]) {
    return '';
  }

  const data =
    block[type];

  if (
    !data.rich_text
  ) {
    return '';
  }

  return data.rich_text
    .map(
      item =>
        item.plain_text ||
        (
          item.text &&
          item.text.content
        ) ||
        ''
    )
    .join('');
}


// ============================================================================
// 45 — DOSSIER DOCUMENTÉ
// ============================================================================

function transfert35_dossierDocumente_(dossier) {
  if (!dossier) {
    return false;
  }

  const statut =
    normalize_(
      transfert35_prop_(
        dossier,
        ['Statut documentaire']
      )
    );

  if (
    statut === 'dossier constitue' ||
    statut === 'dossier documente'
  ) {
    return true;
  }

  const blocks =
    transfert35_blocks_(
      dossier.id
    );

  const text =
    normalize_(
      blocks
        .map(
          transfert35_blockText_
        )
        .join('\n')
    );

  return (
    text.indexOf(
      'recherche documentaire'
    ) !== -1 &&
    text.indexOf(
      'sources'
    ) !== -1
  );
}


// ============================================================================
// 46 — RECHERCHE DU DOSSIER ASSOCIÉ
// ============================================================================

function transfert35_findDossier_(radar) {
  const pages =
    queryDataSourceAll_(
      CONFIG.DOSSIERS_DATA_SOURCE_ID
    );

  const cibleNom =
    normalize_(
      radar.nom
    );

  const cibleSujet =
    normalize_(
      radar.sujet
    );

  const cibleTaxon =
    normalize_(
      radar.taxon
    );

  for (const page of pages) {
    const relation =
      findProperty_(
        page,
        ['Radar scientifique']
      );

    if (
      relation &&
      relation.type === 'relation' &&
      relation.relation
    ) {
      const ids =
        relation.relation.map(
          x => x.id
        );

      if (
        ids.indexOf(
          radar.id
        ) !== -1
      ) {
        return page;
      }
    }
  }

  for (const page of pages) {
    const nom =
      normalize_(
        transfert35_prop_(
          page,
          ['Nom']
        )
      );

    const sujet =
      normalize_(
        transfert35_prop_(
          page,
          ['Sujet']
        )
      );

    const taxon =
      normalize_(
        transfert35_prop_(
          page,
          ['Taxon']
        )
      );

    if (
      cibleNom &&
      nom === cibleNom
    ) {
      return page;
    }

    if (
      cibleSujet &&
      sujet &&
      sujet === cibleSujet
    ) {
      return page;
    }

    if (
      cibleTaxon &&
      taxon &&
      taxon === cibleTaxon &&
      (
        !cibleSujet ||
        !sujet ||
        sujet === cibleSujet
      )
    ) {
      return page;
    }
  }

  return null;
}


