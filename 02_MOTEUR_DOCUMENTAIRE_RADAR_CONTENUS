    CONFIG.CONTENUS_DATA_SOURCE_ID
  );
}


function transfert35_findSchemaProperty_(
  schema,
  names
) {
  const properties =
    schema.properties || {};

  const wanted =
    Array.isArray(names)
      ? names
      : [names];

  for (const name of wanted) {
    if (
      properties[name]
    ) {
      return {
        name: name,
        definition:
          properties[name]
      };
    }
  }

  const normalized =
    wanted.map(
      normalize_
    );

  for (const key in properties) {
    if (
      normalized.indexOf(
        normalize_(key)
      ) !== -1
    ) {
      return {
        name: key,
        definition:
          properties[key]
      };
    }
  }

  return null;
}


function transfert35_cleanMultiSelect_(
  value,
  schemaProperty
) {
  if (
    !value ||
    !schemaProperty
  ) {
    return [];
  }

  const options =
    schemaProperty.multi_select &&
    schemaProperty.multi_select.options
      ? schemaProperty.multi_select.options
      : [];

  const allowed =
    options.map(
      x =>
        normalize_(
          x.name
        )
    );

  return String(value)
    .split(',')
    .map(
      x => clean_(x)
    )
    .filter(Boolean)
    .filter(
      x =>
        allowed.indexOf(
          normalize_(x)
        ) !== -1
    )
    .map(
      x => ({
        name: x
      })
    );
}


// ============================================================================
// 49 — PROPRIÉTÉS CONTENUS
// ============================================================================

function transfert35_contentProperties_(
  radar,
  schema
) {
  const properties = {};

  const mapText = [
    ['Sujet', ['Sujet'], 'sujet'],
    ['Taxon', ['Taxon'], 'taxon'],
    [
      'Localisation',
      ['Localisation'],
      'localisation'
    ],
    ['Résumé', ['Résumé'], 'resume'],
    ['Auteurs', ['Auteurs'], 'auteurs'],
    ['Notes', ['Notes'], 'notes']
  ];

  const title =
    transfert35_findSchemaProperty_(
      schema,
      ['Nom']
    );

  if (title) {
    properties[title.name] =
      titleValue_(
        radar.nom ||
        radar.sujet ||
        'Contenu'
      );
  }

  for (const row of mapText) {
    const schemaProp =
      transfert35_findSchemaProperty_(
        schema,
        row[1]
      );

    if (
      !schemaProp
    ) {
      continue;
    }

    if (
      schemaProp.definition.type ===
      'rich_text'
    ) {
      properties[schemaProp.name] =
        richTextValueForNotion_(
          radar[row[2]]
        );
    }
  }

  const doiProp =
    transfert35_findSchemaProperty_(
      schema,
      ['DOI']
    );

  if (
    doiProp &&
    doiProp.definition.type ===
      'url' &&
    radar.doi
  ) {
    properties[doiProp.name] =
      urlValue_(
        radar.doi
      );
  }

  const sourceProp =
    transfert35_findSchemaProperty_(
      schema,
      ['Source primaire']
    );

  if (
    sourceProp &&
    sourceProp.definition.type ===
      'url' &&
    radar.sourcePrimaire
  ) {
    properties[sourceProp.name] =
      urlValue_(
        radar.sourcePrimaire
      );
  }

  const dateProp =
    transfert35_findSchemaProperty_(
      schema,
      ['Date de publication']
    );

  if (
    dateProp &&
    dateProp.definition.type ===
      'date' &&
    radar.datePublication
  ) {
    properties[dateProp.name] = {
      date: {
        start:
          radar.datePublication
      }
    };
  }

  const natureProp =
    transfert35_findSchemaProperty_(
      schema,
      ['Nature du sujet']
    );

  if (
    natureProp &&
    natureProp.definition.type ===
      'select' &&
    radar.natureSujet
  ) {
    const options =
      natureProp.definition
        .select &&
      natureProp.definition.select
        .options
        ? natureProp.definition.select.options
        : [];

    const found =
      options.find(
        x =>
          normalize_(x.name) ===
          normalize_(
            radar.natureSujet
          )
      );

    if (found) {
      properties[
        natureProp.name
      ] = {
        select: {
          name: found.name
        }
      };
    }
  }

  const formatProp =
    transfert35_findSchemaProperty_(
      schema,
      ['Format']
    );

  if (
    formatProp &&
    formatProp.definition.type ===
      'multi_select' &&
    radar.format
  ) {
    const values =
      transfert35_cleanMultiSelect_(
        radar.format,
        formatProp.definition
      );

    properties[
      formatProp.name
    ] = {
      multi_select:
        values
    };
  }

  return properties;
}


// ============================================================================
// 50 — CORPS DU CONTENU : TOUTES LES DONNÉES
// ============================================================================

function transfert35_body_(
  radar,
  dossier
) {
  const blocks = [];

  blocks.push(
    heading2_(
      'Provenance — transfert depuis le Radar'
    )
  );

  blocks.push(
    paragraph_(
      'Page Radar : ' +
      radar.id
    )
  );

  if (radar.url) {
    blocks.push(
      paragraph_(
        'URL Radar : ' +
        radar.url
      )
    );
  }

  if (dossier) {
    blocks.push(
      paragraph_(
        'Page Dossier : ' +
        dossier.id
      )
    );

    if (dossier.url) {
      blocks.push(
        paragraph_(
          'URL Dossier : ' +
          dossier.url
        )
      );
    }
  }

  blocks.push(
    heading2_(
      'Données complètes du Radar'
    )
  );

  const radarRows = [
    ['Nom', radar.nom],
    ['Sujet', radar.sujet],
    ['Taxon', radar.taxon],
    [
      'Nature du sujet',
      radar.natureSujet
    ],
    [
      'Localisation',
      radar.localisation
    ],
    ['Résumé', radar.resume],
    ['Auteurs', radar.auteurs],
    [
      'Date de publication',
      radar.datePublication
    ],
    ['DOI', radar.doi],
    [
      'Source primaire',
      radar.sourcePrimaire
    ],
    ['Notes', radar.notes],
    [
      'Score éditorial',
      radar.scoreEditorial
    ],
    [
      'Potentiel PVV',
      radar.potentielPVV
    ],
    [
      'Type de découverte',
      radar.typeDecouverte
    ],
    [
      'Source de détection',
      radar.sourceDetection
    ],
    ['Domaine', radar.domaine],
    ['Confiance', radar.confiance],
    ['Format', radar.format],
    [
      'Date de détection',
      radar.dateDetection
    ],
    [
      'Déjà dans les contenus',
      radar.dejaDansContenus
        ? 'true'
        : 'false'
    ],
    [
      'Sujet retenu',
      radar.sujetRetenu
        ? 'true'
        : 'false'
    ],
    [
      'Recherche documentaire',
      radar.rechercheDocumentaire
        ? 'true'
        : 'false'
    ],
    [
      'Statut radar',
      radar.statutRadar
    ],
    [
      'Date de création Notion',
      radar.createdTime
    ]
  ];

  for (const row of radarRows) {
    if (
      row[1] === undefined ||
      row[1] === null ||
      row[1] === ''
    ) {
      continue;
    }

    blocks.push(
      paragraph_(
        row[0] +
        ' : ' +
        String(row[1])
      )
    );
  }

  if (dossier) {
    blocks.push(
      heading2_(
        'Documentation du Dossier'
      )
    );

    const dossierBlocks =
      transfert35_blocks_(
        dossier.id
      );

    if (!dossierBlocks.length) {
      blocks.push(
        paragraph_(
          'Aucun bloc documentaire récupérable.'
        )
      );
    }

    for (
      const block of dossierBlocks
    ) {
      const text =
        transfert35_blockText_(
          block
        );

      if (text) {
        blocks.push(
          paragraph_(
            text
          )
        );
      }
    }
  }

  return blocks;
}


// ============================================================================
// 51 — CRÉATION DU CONTENU
// ============================================================================

function transfert35_create_(
  radar,
  dossier
) {
  const existing =
    transfert35_existingContent_(
      radar
    );

  if (existing) {
    Logger.log(
      'CONTENU EXISTANT : ' +
      radar.nom
    );

    return existing;
  }

  const schema =
    transfert35_schema_();

  const properties =
    transfert35_contentProperties_(
      radar,
      schema
    );

  const page =
    createPage_(
      CONFIG.CONTENUS_DATA_SOURCE_ID,
      properties
    );

  const blocks =
    transfert35_body_(
      radar,
      dossier
    );

  appendBlocks_(
    page.id,
    blocks
  );

  const verify =
    notionRequest_(
      'get',
      '/pages/' +
      page.id
    );

  const title =
    transfert35_prop_(
      verify,
      ['Nom']
    );

  if (
    !title ||
    normalize_(title) !==
      normalize_(
        radar.nom ||
        radar.sujet ||
        'Contenu'
      )
  ) {
    throw new Error(
      'Vérification du Contenu créé impossible pour : ' +
      radar.nom
    );
  }

  return verify;
}


// ============================================================================
// 52 — ARCHIVAGE RADAR APRÈS TRANSFERT
// ============================================================================

function transfert35_deleteRadar_(
  radar
) {
  Logger.log(
    'ARCHIVAGE RADAR : ' +
    radar.nom
  );

  archiverPage_(
    radar.id
  );
}


// ============================================================================
// 53 — ÉLIGIBILITÉ TRANSFERT
// ============================================================================

function sujetEligibleTransfert_(
  radar,
  dossier
) {
  if (
    !radar.sujetRetenu
  ) {
    return false;
  }

  if (
    !dossier
  ) {
    return false;
  }

  return transfert35_dossierDocumente_(
    dossier
  );
}


// ============================================================================
// 54 — TEST TRANSFERT LECTURE SEULE
// ============================================================================

function testTransfertRadarVersContenus() {
  Logger.log(
    '========================================'
  );

  Logger.log(
    'TEST TRANSFERT RADAR → CONTENUS'
  );

  Logger.log(
    'LECTURE SEULE — AUCUNE ÉCRITURE'
  );

  Logger.log(
    '========================================'
  );

  const pages =
    queryDataSourceAll_(
      CONFIG.RADAR_DATA_SOURCE_ID
    );

  let eligible = 0;

  for (const page of pages) {
    const radar =
      transfert35_readRadar_(
        page
      );

    if (
      !radar.sujetRetenu
    ) {
      continue;
    }

    Logger.log(
      '----------------------------------------'
    );

    Logger.log(
      'SUJET RETENU : ' +
      radar.nom
    );

    const dossier =
      transfert35_findDossier_(
        radar
      );

    Logger.log(
      'Dossier : ' +
      (
        dossier
          ? transfert35_prop_(
              dossier,
              ['Nom']
            )
          : 'NON TROUVÉ'
      )
    );

    const documente =
      dossier
        ? transfert35_dossierDocumente_(
            dossier
          )
        : false;

    Logger.log(
      'Recherche documentaire terminée : ' +
      (
        documente
          ? 'OUI'
          : 'NON'
      )
    );

    const existing =
      transfert35_existingContent_(
        radar
      );

    Logger.log(
      'Contenu déjà présent : ' +
      (
        existing
          ? 'OUI'
          : 'NON'
      )
    );

    if (
      sujetEligibleTransfert_(
        radar,
        dossier
      )
    ) {
      eligible++;

      Logger.log(
        '>>> ÉLIGIBLE AU TRANSFERT'
      );
    } else {
      Logger.log(
        '>>> NON ÉLIGIBLE'
      );
    }
  }

  Logger.log(
    '========================================'
  );

  Logger.log(
    'SUJETS ÉLIGIBLES : ' +
    eligible
  );

  Logger.log(
    'TEST TERMINÉ — AUCUNE ÉCRITURE'
  );
}


// ============================================================================
// 55 — TRANSFERT RÉEL
// ============================================================================

function lancerTransfertRadarVersContenus() {
  Logger.log(
    '========================================'
  );

  Logger.log(
    'TRANSFERT RADAR → CONTENUS'
  );

  Logger.log(
    'MODE RÉEL — ÉCRITURE + ARCHIVAGE APRÈS VÉRIFICATION'
  );

  Logger.log(
    '========================================'
  );

  const pages =
    queryDataSourceAll_(
      CONFIG.RADAR_DATA_SOURCE_ID
    );

  let transferes = 0;

  for (const page of pages) {
    const radar =
      transfert35_readRadar_(
        page
      );

    if (
      !radar.sujetRetenu
    ) {
      continue;
    }

    Logger.log(
      '----------------------------------------'
    );

    Logger.log(
      'SUJET RETENU : ' +
      radar.nom
    );

    try {
      const dossier =
        transfert35_findDossier_(
          radar
        );

      if (
        !dossier
      ) {
        Logger.log(
          'Dossier introuvable — transfert annulé.'
        );

        continue;
      }

      if (
        !transfert35_dossierDocumente_(
          dossier
        )
      ) {
        Logger.log(
          'Documentation incomplète — transfert annulé.'
        );

        continue;
      }

      const contenu =
        transfert35_create_(
          radar,
          dossier
        );

      if (
        !contenu ||
        !contenu.id
      ) {
        throw new Error(
          'Le Contenu n’a pas pu être créé ou retrouvé.'
        );
      }

      const verification =
        notionRequest_(
          'get',
          '/pages/' +
          contenu.id
        );

      const titreVerification =
        transfert35_prop_(
          verification,
          ['Nom']
        );

      if (
        normalize_(
          titreVerification
        ) !==
        normalize_(
          radar.nom ||
          radar.sujet
        )
      ) {
        throw new Error(
          'Échec de vérification finale du Contenu.'
        );
      }

      transfert35_deleteRadar_(
        radar
      );

      transferes++;

      Logger.log(
        'TRANSFERT TERMINÉ : ' +
        radar.nom
      );

    } catch (e) {
      Logger.log(
        'ERREUR TRANSFERT ' +
        radar.nom +
        ' → ' +
        e.message
      );
    }
  }

  Logger.log(
    '========================================'
  );

  Logger.log(
    'TRANSFERTS TERMINÉS : ' +
    transferes
  );

  Logger.log(
    'FIN DU TRANSFERT RADAR → CONTENUS'
  );
}


