// ============================================================================
// 13 — EXCLUSIONS D’AUTEURS
// ============================================================================

const AUTEURS_EXCLUS = [
  'wikipedia',
  'wikimedia',
  'facebook',
  'instagram',
  'reddit',
  'youtube',
  'pinterest'
];


function auteurExclu_(text) {
  const n = normalize_(text);

  return AUTEURS_EXCLUS.some(
    mot => n.indexOf(normalize_(mot)) !== -1
  );
}


// ============================================================================
// 14 — MOTS TAXONOMIQUES IMPOSSIBLES
// ============================================================================

const TAXON_IMPOSSIBLE = [
  'new species',
  'sp. nov',
  'gen. nov',
  'family',
  'order',
  'class',
  'phylum',
  'kingdom',
  'species',
  'genus'
];


function taxonImpossible_(value) {
  const n = normalize_(value);

  return TAXON_IMPOSSIBLE.some(
    mot => n === normalize_(mot)
  );
}


// ============================================================================
// 15 — VALIDATION BINOMINALE
// ============================================================================

function binomeValide_(value) {
  const text = clean_(value);

  return /^[A-Z][a-z-]{2,30}\s+[a-z][a-z-]{2,40}$/.test(text);
}


// ============================================================================
// 16 — EXTRACTION BINOMINALE STRICTE
// ============================================================================

function extraireBinome_(text) {
  const source = String(text || '');

  const regex =
    /\b([A-Z][a-z-]{2,30})\s+([a-z][a-z-]{2,40})\b/g;

  const candidats = [];
  let match;

  while ((match = regex.exec(source)) !== null) {
    const binome =
      match[1] + ' ' + match[2];

    if (
      binomeValide_(binome) &&
      !taxonImpossible_(match[1]) &&
      !taxonImpossible_(match[2])
    ) {
      candidats.push(binome);
    }
  }

  return candidats;
}


// ============================================================================
// 17 — EXTRACTION ESPÈCE
// ============================================================================

function extraireEspece_(text) {
  const candidats = extraireBinome_(text);

  if (!candidats.length) {
    return null;
  }

  return candidats[0];
}


// ============================================================================
// 18 — EXTRACTION GENRE
// ============================================================================

function extraireGenre_(text) {
  const source = String(text || '');

  const match = source.match(
    /\b([A-Z][a-z-]{2,30})\b/
  );

  if (!match) {
    return null;
  }

  if (taxonImpossible_(match[1])) {
    return null;
  }

  return match[1];
}


// ============================================================================
// 19 — DÉTECTION NOUVELLE ESPÈCE
// ============================================================================

function detecterNouvelleEspece_(text) {
  const n = normalize_(text);

  const indicateurs = [
    'new species',
    'new species of',
    'a new species',
    'new species from',
    'sp. nov',
    'species nova',
    'newly described',
    'newly described species',
    'description of a new species',
    'description of two new species',
    'description of three new species',
    'nouvelle espece',
    'nouvelle espèce',
    'deux nouvelles especes',
    'deux nouvelles espèces'
  ];

  return indicateurs.some(
    mot => n.indexOf(normalize_(mot)) !== -1
  );
}


// ============================================================================
// 20 — CONSTRUCTION DES REQUÊTES
// ============================================================================

function construireRequetes_(radar) {
  const requetes = [];

  const sujet = clean_(radar.sujet);
  const taxon = clean_(radar.taxon);
  const nom = clean_(radar.nom);

  if (sujet) {
    requetes.push(sujet);
  }

  if (taxon && sujet) {
    requetes.push(
      taxon + ' ' + sujet
    );
  }

  if (nom && nom !== sujet) {
    requetes.push(nom);
  }

  if (taxon) {
    requetes.push(taxon);
  }

  return [...new Set(
    requetes.filter(Boolean)
  )];
}


// ============================================================================
// 21 — JSON PUBLIC
// ============================================================================

function publicJson_(url) {
  const response = UrlFetchApp.fetch(
    url,
    {
      muteHttpExceptions: true,
      headers: {
        'User-Agent':
          'Passons-au-Vert-documentation/1.0'
      }
    }
  );

  const code = response.getResponseCode();

  if (code < 200 || code >= 300) {
    return null;
  }

  try {
    return JSON.parse(
      response.getContentText()
    );
  } catch (e) {
    return null;
  }
}


// ============================================================================
// 22 — CROSSREF
// ============================================================================

function rechercherCrossref_(query) {
  const url =
    'https://api.crossref.org/works?query.bibliographic=' +
    encodeURIComponent(query) +
    '&rows=10';

  const json = publicJson_(url);

  if (
    !json ||
    !json.message ||
    !json.message.items
  ) {
    return [];
  }

  return json.message.items.map(item => ({
    type: 'crossref',
    title:
      (item.title && item.title[0]) || '',
    authors:
      (item.author || [])
        .map(a =>
          [a.given, a.family]
            .filter(Boolean)
            .join(' ')
        )
        .join(', '),
    journal:
      (item['container-title'] &&
        item['container-title'][0]) ||
      '',
    date:
      item.published &&
      item.published['date-parts']
        ? item.published['date-parts'][0]
            .join('-')
        : '',
    doi:
      item.DOI || '',
    url:
      item.URL || ''
  }));
}

// ============================================================================
// 22B — SOURCE CIBLÉE : NEOTROPICAL ICHTHYOLOGY
// ============================================================================
// Recherche ciblée dans Crossref, limitée aux articles indexés sous le titre
// de revue Neotropical Ichthyology. Cela complète la recherche bibliographique
// générale sans remplacer Crossref, GBIF ou Wikimedia.
// ============================================================================
function rechercherNeotropicalIchthyology_(query) {
  const url =
    'https://api.crossref.org/works?query.container-title=' +
    encodeURIComponent('Neotropical Ichthyology') +
    '&query.bibliographic=' +
    encodeURIComponent(query) +
    '&filter=type:journal-article' +
    '&rows=10';

  const json = publicJson_(url);

  if (!json || !json.message || !Array.isArray(json.message.items)) {
    return [];
  }

  return json.message.items.map(item => ({
    type: 'crossref',
    title: (item.title && item.title[0]) || '',
    authors: (item.author || [])
      .map(a => [a.given, a.family].filter(Boolean).join(' '))
      .join(', '),
    journal: (item['container-title'] && item['container-title'][0]) || 'Neotropical Ichthyology',
    date: item.published && item.published['date-parts']
      ? item.published['date-parts'][0].join('-')
      : '',
    doi: item.DOI || '',
    url: item.URL || ''
  }));
}



// ============================================================================
// 23 — WIKIMEDIA
// ============================================================================

function rechercherWikimedia_(query) {
  const url =
    'https://commons.wikimedia.org/w/api.php?' +
    'action=query' +
    '&format=json' +
    '&generator=search' +
    '&gsrsearch=' +
    encodeURIComponent(query) +
    '&gsrnamespace=6' +
    '&gsrlimit=10' +
    '&prop=imageinfo' +
    '&iiprop=url';

  const json = publicJson_(url);

  if (
    !json ||
    !json.query ||
    !json.query.pages
  ) {
    return [];
  }

  return Object.keys(
    json.query.pages
  ).map(id => {
    const item =
      json.query.pages[id];

    return {
      type: 'wikimedia',
      title: item.title || '',
      url:
        item.imageinfo &&
        item.imageinfo[0]
          ? item.imageinfo[0].descriptionurl || ''
          : ''
    };
  });
}


// ============================================================================
// 24 — GBIF
// ============================================================================

function rechercherGBIF_(query) {
  const url =
    'https://api.gbif.org/v1/species/match?name=' +
    encodeURIComponent(query);

  const json = publicJson_(url);

  if (!json) {
    return [];
  }

  return [
    {
      type: 'gbif',
      title:
        json.scientificName ||
        query,
      key:
        json.usageKey || '',
      rank:
        json.rank || '',
      status:
        json.status || '',
      acceptedName:
        json.species ||
        json.scientificName ||
        ''
    }
  ];
}


// ============================================================================
// 25 — CLASSIFICATION DES SOURCES
// ============================================================================

function classifierSource_(source, radar) {
  const title = normalize_(
    source.title
  );

  const taxon = normalize_(
    radar.taxon
  );

  const sujet = normalize_(
    radar.sujet
  );

  const text =
    title +
    ' ' +
    normalize_(source.authors) +
    ' ' +
    normalize_(source.journal);

  if (
    source.type === 'crossref' &&
    radar.doi &&
    normalize_(source.doi) ===
      normalize_(radar.doi)
  ) {
    return {
      niveau: 5,
      label: 'ESSENTIEL'
    };
  }

  if (
    taxon &&
    text.indexOf(taxon) !== -1
  ) {
    return {
      niveau: 4,
      label: 'DIRECT'
    };
  }

  if (
    source.type === 'gbif' &&
    taxon &&
    normalize_(
      source.title
    ).indexOf(taxon) !== -1
  ) {
    return {
      niveau: 4,
      label: 'DIRECT'
    };
  }

  if (
    source.type === 'wikimedia'
  ) {
    return {
      niveau: 1,
      label: 'PISTE'
    };
  }

  return {
    niveau: 0,
    label: 'HORS SUJET'
  };
}


// ============================================================================
// 26 — DOSSIERS
// ============================================================================

function getDossierPages_() {
  return queryDataSourceAll_(
    CONFIG.DOSSIERS_DATA_SOURCE_ID
  );
}


function trouverDossierParNom_(radar) {
  const pages = getDossierPages_();

  const cible = normalize_(
    radar.nom ||
    radar.sujet
  );

  for (const page of pages) {
    const nom = normalize_(
      propText_(
        findProperty_(page, ['Nom'])
      )
    );

    if (
      nom &&
      nom === cible
    ) {
      return page;
    }
  }

  return null;
}


// ============================================================================
// 27 — VÉRIFICATION DOSSIER DOCUMENTÉ
// ============================================================================

function dossierDocumente_(page) {
  if (!page) {
    return false;
  }

  const statut = normalize_(
    propText_(
      findProperty_(
        page,
        ['Statut documentaire']
      )
    )
  );

  if (
    statut === 'dossier constitue' ||
    statut === 'dossier documente'
  ) {
    return true;
  }

  const blocs =
    getPageBlocks_(page.id);

  const texte = normalize_(
    blocs
      .map(b => {
        if (
          b.type === 'paragraph'
        ) {
          return (
            b.paragraph.rich_text || []
          )
            .map(x => x.plain_text || '')
            .join(' ');
        }

        if (
          b.type === 'heading_2'
        ) {
          return (
            b.heading_2.rich_text || []
          )
            .map(x => x.plain_text || '')
            .join(' ');
        }

        return '';
      })
      .join(' ')
  );

  return (
    texte.indexOf(
      'recherche documentaire'
    ) !== -1 &&
    texte.indexOf(
      'sources'
    ) !== -1
  );
}


// ============================================================================
// 28 — CRÉATION DOSSIER
// ============================================================================

function creerDossier_(radar) {
  const properties = {};

  const schema =
    getDataSource_(
      CONFIG.DOSSIERS_DATA_SOURCE_ID
    );

  const schemaProperties =
    schema.properties || {};

  const nomProp =
    Object.keys(schemaProperties)
      .find(
        key =>
          normalize_(key) ===
          normalize_('Nom')
      );

  if (nomProp) {
    properties[nomProp] =
      titleValue_(
        radar.nom ||
        radar.sujet ||
        'Dossier'
      );
  }

  const sujetProp =
    Object.keys(schemaProperties)
      .find(
        key =>
          normalize_(key) ===
          normalize_('Sujet')
      );

  if (sujetProp) {
    properties[sujetProp] =
      richTextValueForNotion_(
        radar.sujet
      );
  }

  const taxonProp =
    Object.keys(schemaProperties)
      .find(
        key =>
          normalize_(key) ===
          normalize_('Taxon')
      );

  if (taxonProp) {
    properties[taxonProp] =
      richTextValueForNotion_(
        radar.taxon
      );
  }

  const statutProp =
    Object.keys(schemaProperties)
      .find(
        key =>
          normalize_(key) ===
          normalize_('Statut documentaire')
      );

  if (
    statutProp &&
    schemaProperties[statutProp].type ===
      'status'
  ) {
    properties[statutProp] = {
      status: {
        name: 'Dossier constitué'
      }
    };
  }

  const dateProp =
    Object.keys(schemaProperties)
      .find(
        key =>
          normalize_(key) ===
          normalize_(
            'Date dernière recherche'
          )
      );

  if (dateProp) {
    properties[dateProp] = {
      date: {
        start: today_()
      }
    };
  }

  return createPage_(
    CONFIG.DOSSIERS_DATA_SOURCE_ID,
    properties
  );
}


// ============================================================================
// 29 — DOI
// ============================================================================

function normaliserDOI_(doi) {
  return String(doi || '')
    .replace(/^https?:\/\/doi\.org\//i, '')
    .replace(/^doi:\s*/i, '')
    .trim();
}


// ============================================================================
// 30 — FORMATAGE SOURCE
// ============================================================================

function formaterSource_(source, classification) {
  const lignes = [];

  lignes.push(
    '[' +
    classification.niveau +
    ' — ' +
    classification.label +
    ']'
  );

  if (source.title) {
    lignes.push(
      source.title
    );
  }

  if (source.authors) {
    lignes.push(
      'Auteurs : ' +
      source.authors
    );
  }

  if (source.journal) {
    lignes.push(
      'Publication : ' +
      source.journal
    );
  }

  if (source.date) {
    lignes.push(
      'Date : ' +
      source.date
    );
  }

  if (source.doi) {
    lignes.push(
      'DOI : ' +
      source.doi
    );
  }

  if (source.url) {
    lignes.push(
      'URL : ' +
      source.url
    );
  }

  return lignes.join('\n');
}


// ============================================================================
// 31 — DÉDOUBLONNAGE
// ============================================================================

function dedoublonnerSources_(sources) {
  const seen = {};
  const result = [];

  for (const source of sources) {
    const key = normalize_(
      [
        source.type,
        source.title,
        source.doi,
        source.url
      ].join('|')
    );

    if (!seen[key]) {
      seen[key] = true;
      result.push(source);
    }
  }

  return result;
}


