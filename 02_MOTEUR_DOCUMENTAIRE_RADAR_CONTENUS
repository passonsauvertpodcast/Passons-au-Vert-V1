// ============================================================================
// 2 — TOKEN NOTION
// ============================================================================

function getNotionToken_() {
  const token = PropertiesService
    .getScriptProperties()
    .getProperty('NOTION_TOKEN');

  if (!token) {
    throw new Error(
      'NOTION_TOKEN introuvable dans les propriétés du script.'
    );
  }

  return token;
}


// ============================================================================
// 3 — API NOTION
// ============================================================================

function notionRequest_(method, path, payload) {
  const token = getNotionToken_();

  const options = {
    method: method,
    headers: {
      'Authorization': 'Bearer ' + token,
      'Notion-Version': CONFIG.NOTION_VERSION,
      'Content-Type': 'application/json'
    },
    muteHttpExceptions: true
  };

  if (payload !== undefined && payload !== null) {
    options.payload = JSON.stringify(payload);
  }

  const url = 'https://api.notion.com/v1' + path;

  const response = UrlFetchApp.fetch(url, options);
  const code = response.getResponseCode();
  const text = response.getContentText();

  let json;

  try {
    json = JSON.parse(text);
  } catch (e) {
    json = {
      raw: text
    };
  }

  if (code < 200 || code >= 300) {
    throw new Error(
      'Notion API ' +
      method +
      ' ' +
      path +
      ' → HTTP ' +
      code +
      ' : ' +
      text
    );
  }

  return json;
}


// ============================================================================
// 4 — DATA SOURCE
// ============================================================================

function getDataSource_(dataSourceId) {
  return notionRequest_(
    'get',
    '/data_sources/' + dataSourceId
  );
}


// ============================================================================
// 5 — REQUÊTE COMPLÈTE D’UN DATA SOURCE
// ============================================================================

function queryDataSourceAll_(dataSourceId) {
  const results = [];
  let cursor = null;

  while (true) {
    const payload = {
      page_size: 100
    };

    if (cursor) {
      payload.start_cursor = cursor;
    }

    const response = notionRequest_(
      'post',
      '/data_sources/' + dataSourceId + '/query',
      payload
    );

    if (response.results) {
      results.push.apply(results, response.results);
    }

    if (!response.has_more || !response.next_cursor) {
      break;
    }

    cursor = response.next_cursor;
  }

  return results;
}


// ============================================================================
// 6 — OUTILS GÉNÉRAUX
// ============================================================================

function normalize_(value) {
  return String(value || '')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/\s+/g, ' ')
    .trim();
}


function clean_(value) {
  return String(value || '')
    .replace(/\s+/g, ' ')
    .trim();
}


function today_() {
  return Utilities.formatDate(
    new Date(),
    Session.getScriptTimeZone() || 'Europe/Paris',
    'yyyy-MM-dd'
  );
}


function truncate_(value, max) {
  const text = String(value || '');

  if (text.length <= max) {
    return text;
  }

  return text.substring(0, max - 1) + '…';
}


// ============================================================================
// 7 — PROPRIÉTÉS NOTION
// ============================================================================

function findProperty_(page, names) {
  if (!page || !page.properties) {
    return null;
  }

  const wanted = Array.isArray(names) ? names : [names];

  for (const name of wanted) {
    if (page.properties[name]) {
      return page.properties[name];
    }
  }

  const normalizedNames = wanted.map(normalize_);

  for (const key in page.properties) {
    if (
      normalizedNames.indexOf(
        normalize_(key)
      ) !== -1
    ) {
      return page.properties[key];
    }
  }

  return null;
}


function findPropertyName_(page, names) {
  if (!page || !page.properties) {
    return null;
  }

  const wanted = Array.isArray(names) ? names : [names];

  for (const name of wanted) {
    if (page.properties[name]) {
      return name;
    }
  }

  const normalizedNames = wanted.map(normalize_);

  for (const key in page.properties) {
    if (
      normalizedNames.indexOf(
        normalize_(key)
      ) !== -1
    ) {
      return key;
    }
  }

  return null;
}


function propText_(property) {
  if (!property) {
    return '';
  }

  if (property.type === 'title') {
    return (property.title || [])
      .map(x => x.plain_text || '')
      .join('');
  }

  if (property.type === 'rich_text') {
    return (property.rich_text || [])
      .map(x => x.plain_text || '')
      .join('');
  }

  if (property.type === 'select') {
    return property.select ? property.select.name || '' : '';
  }

  if (property.type === 'status') {
    return property.status ? property.status.name || '' : '';
  }

  if (property.type === 'multi_select') {
    return (property.multi_select || [])
      .map(x => x.name || '')
      .join(', ');
  }

  if (property.type === 'url') {
    return property.url || '';
  }

  if (property.type === 'number') {
    return property.number === null ||
      property.number === undefined
      ? ''
      : String(property.number);
  }

  if (property.type === 'date') {
    if (!property.date) {
      return '';
    }

    return property.date.start || '';
  }

  if (property.type === 'checkbox') {
    return property.checkbox ? 'true' : 'false';
  }

  if (property.type === 'formula') {
    if (!property.formula) {
      return '';
    }

    if (property.formula.type === 'string') {
      return property.formula.string || '';
    }

    if (property.formula.type === 'number') {
      return property.formula.number === null
        ? ''
        : String(property.formula.number);
    }

    if (property.formula.type === 'boolean') {
      return property.formula.boolean ? 'true' : 'false';
    }

    if (property.formula.type === 'date') {
      return property.formula.date
        ? property.formula.date.start || ''
        : '';
    }
  }

  if (property.type === 'people') {
    return (property.people || [])
      .map(x => x.name || x.id || '')
      .join(', ');
  }

  if (property.type === 'relation') {
    return (property.relation || [])
      .map(x => x.id || '')
      .join(', ');
  }

  return '';
}


function richTextValueForNotion_(text) {
  return {
    rich_text: [
      {
        type: 'text',
        text: {
          content: truncate_(String(text || ''), 2000)
        }
      }
    ]
  };
}


function urlValue_(url) {
  const value = clean_(url);

  if (!value) {
    return {
      url: null
    };
  }

  return {
    url: value
  };
}


function titleValue_(text) {
  return {
    title: [
      {
        type: 'text',
        text: {
          content: truncate_(String(text || ''), 2000)
        }
      }
    ]
  };
}


function heading2_(text) {
  return {
    object: 'block',
    type: 'heading_2',
    heading_2: {
      rich_text: [
        {
          type: 'text',
          text: {
            content: truncate_(String(text || ''), 2000)
          }
        }
      ]
    }
  };
}


function paragraph_(text) {
  return {
    object: 'block',
    type: 'paragraph',
    paragraph: {
      rich_text: [
        {
          type: 'text',
          text: {
            content: truncate_(String(text || ''), 2000)
          }
        }
      ]
    }
  };
}


// ============================================================================
// 8 — BLOCS NOTION
// ============================================================================

function getPageBlocks_(pageId) {
  const response = notionRequest_(
    'get',
    '/blocks/' + pageId + '/children?page_size=100'
  );

  return response.results || [];
}


function appendBlocks_(pageId, blocks) {
  if (!blocks || !blocks.length) {
    return;
  }

  for (
    let i = 0;
    i < blocks.length;
    i += CONFIG.MAX_BLOCKS_PER_APPEND
  ) {
    const chunk = blocks.slice(
      i,
      i + CONFIG.MAX_BLOCKS_PER_APPEND
    );

    notionRequest_(
      'patch',
      '/blocks/' + pageId + '/children',
      {
        children: chunk
      }
    );
  }
}


