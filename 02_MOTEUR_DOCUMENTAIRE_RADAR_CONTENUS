// ============================================================================
// 39 — IUCN
// ============================================================================

function rechercherIUCNEspece_(genre, espece) {
  if (!genre || !espece) {
    return null;
  }

  const url =
    CONFIG.IUCN_API_BASE +
    '/taxa/scientific_name?genus_name=' +
    encodeURIComponent(genre) +
    '&species_name=' +
    encodeURIComponent(espece);

  const response =
    UrlFetchApp.fetch(
      url,
      {
        muteHttpExceptions: true,
        headers: {
          'Authorization':
            'Bearer ' +
            getIUCNToken_()
        }
      }
    );

  const code =
    response.getResponseCode();

  if (code < 200 || code >= 300) {
    return null;
  }

  try {
    return JSON.parse(
      response.getContentText()
    );
  } catch (e) {
    return null;
  }
}


function getIUCNToken_() {
  const token =
    PropertiesService
      .getScriptProperties()
      .getProperty(
        'IUCN_TOKEN'
      );

  if (!token) {
    throw new Error(
      'IUCN_TOKEN introuvable dans les propriétés du script.'
    );
  }

  return token;
}


