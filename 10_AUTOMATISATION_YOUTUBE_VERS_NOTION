/* ================================================================
   DIAGNOSTIC — ÉCART ENTRE UPLOADS ET VIDEOS.LIST
   ================================================================ */

/**
 * DIAGNOSTIC LECTURE SEULE.
 *
 * Compare :
 *
 * 1. les entrées de la playlist Uploads ;
 * 2. les vidéos uniques de cette playlist ;
 * 3. les vidéos retournées par YouTube.Videos.list().
 *
 * OBJECTIF :
 * déterminer précisément pourquoi le listing du fichier 88
 * donne 56 vidéos uniques alors que le moteur de synchronisation
 * peut éventuellement en retourner moins.
 *
 * IMPORTANT :
 * - aucune modification de Notion ;
 * - aucune modification de YouTube ;
 * - aucune création de page ;
 * - aucun changement de propriété ;
 * - aucune modification de déclencheur.
 */
function diagnostiquerEcartVideosYouTube() {

  Logger.log(
    '============================================================'
  );

  Logger.log(
    'DIAGNOSTIC ÉCART VIDÉOS YOUTUBE'
  );

  Logger.log(
    '============================================================'
  );


  /* ------------------------------------------------------------
     1. RÉCUPÉRATION DE LA CHAÎNE
     ------------------------------------------------------------ */

  const chaine =
    recupererChaineYouTubePourSynchronisation();

  if (
    !chaine ||
    !chaine.id
  ) {
    throw new Error(
      'Impossible de récupérer la chaîne YouTube.'
    );
  }


  Logger.log(
    'Chaîne : ' +
    chaine.snippet.title
  );

  Logger.log(
    'ID : ' +
    chaine.id
  );


  /* ------------------------------------------------------------
     2. RÉCUPÉRATION DE LA PLAYLIST UPLOADS
     ------------------------------------------------------------ */

  const uploadsPlaylistId =
    chaine.contentDetails &&
    chaine.contentDetails.relatedPlaylists &&
    chaine.contentDetails.relatedPlaylists.uploads;


  if (!uploadsPlaylistId) {
    throw new Error(
      'Playlist Uploads introuvable.'
    );
  }


  Logger.log(
    'Playlist Uploads : ' +
    uploadsPlaylistId
  );


  /* ------------------------------------------------------------
     3. RÉCUPÉRATION DE TOUTES LES ENTRÉES
     ------------------------------------------------------------ */

  const videosPlaylist = [];

  let pageToken = null;


  do {

    const params = {
      playlistId:
        uploadsPlaylistId,

      maxResults:
        50
    };


    if (pageToken) {

      params.pageToken =
        pageToken;

    }


    const response =
      YouTube.PlaylistItems.list(
        'snippet,contentDetails',
        params
      );


    if (
      response &&
      response.items
    ) {

      response.items.forEach(
        function(item) {

          const videoId =
            item.contentDetails &&
            item.contentDetails.videoId;


          if (!videoId) {
            return;
          }


          videosPlaylist.push({

            id:
              videoId,

            title:
              item.snippet &&
              item.snippet.title
                ? item.snippet.title
                : '',

            publishedAt:
              (
                item.contentDetails &&
                item.contentDetails.videoPublishedAt
              ) ||
              (
                item.snippet &&
                item.snippet.publishedAt
              ) ||
              ''

          });

        }
      );

    }


    pageToken =
      response.nextPageToken ||
      null;


  } while (pageToken);


  Logger.log(
    'Entrées playlist : ' +
    videosPlaylist.length
  );


  /* ------------------------------------------------------------
     4. DÉDOUBLONNAGE DES IDS
     ------------------------------------------------------------ */

  const playlistUniqueParId = {};
  const videosUniques = [];


  videosPlaylist.forEach(
    function(video) {

      if (
        !playlistUniqueParId[video.id]
      ) {

        playlistUniqueParId[video.id] =
          video;

        videosUniques.push(
          video
        );

      }

    }
  );


  Logger.log(
    'Vidéos uniques dans Uploads : ' +
    videosUniques.length
  );


  /* ------------------------------------------------------------
     5. RÉCUPÉRATION DE VIDEOS.LIST
     ------------------------------------------------------------ */

  const videosRetournees = {};


  for (
    let i = 0;
    i < videosUniques.length;
    i += 50
  ) {

    const lot =
      videosUniques.slice(
        i,
        i + 50
      );


    const ids =
      lot
        .map(function(video) {
          return video.id;
        })
        .join(',');


    const response =
      YouTube.Videos.list(
        'snippet,contentDetails,statistics',
        {
          id: ids
        }
      );


    if (
      response &&
      response.items
    ) {

      response.items.forEach(
        function(video) {

          videosRetournees[
            video.id
          ] = video;

        }
      );

    }

  }


  const nombreVideosRetournees =
    Object.keys(
      videosRetournees
    ).length;


  Logger.log(
    'Vidéos retournées par Videos.list : ' +
    nombreVideosRetournees
  );


  /* ------------------------------------------------------------
     6. RECHERCHE DES VIDÉOS MANQUANTES
     ------------------------------------------------------------ */

  const videosManquantes = [];


  videosUniques.forEach(
    function(video) {

      if (
        !videosRetournees[video.id]
      ) {

        videosManquantes.push(
          video
        );

      }

    }
  );


  /* ------------------------------------------------------------
     7. RAPPORT FINAL
     ------------------------------------------------------------ */

  Logger.log(
    '------------------------------------------------------------'
  );

  Logger.log(
    'RÉSULTAT DU DIAGNOSTIC'
  );

  Logger.log(
    '------------------------------------------------------------'
  );

  Logger.log(
    'Entrées Uploads              : ' +
    videosPlaylist.length
  );

  Logger.log(
    'Vidéos uniques Uploads       : ' +
    videosUniques.length
  );

  Logger.log(
    'Vidéos retournées Videos.list: ' +
    nombreVideosRetournees
  );

  Logger.log(
    'Vidéos absentes              : ' +
    videosManquantes.length
  );


  Logger.log(
    '------------------------------------------------------------'
  );


  if (
    videosManquantes.length === 0
  ) {

    Logger.log(
      'AUCUNE VIDÉO MANQUANTE.'
    );

  } else {

    Logger.log(
      'VIDÉOS PRÉSENTES DANS UPLOADS MAIS ABSENTES DE VIDEOS.LIST'
    );


    videosManquantes.forEach(
      function(video, index) {

        Logger.log(
          (index + 1) +
          '. ' +
          video.title +
          ' -> ' +
          video.id +
          ' | ' +
          video.publishedAt
        );

      }
    );

  }


  Logger.log(
    '------------------------------------------------------------'
  );

  Logger.log(
    'Vérification arithmétique : ' +
    videosUniques.length +
    ' - ' +
    nombreVideosRetournees +
    ' = ' +
    videosManquantes.length
  );


  Logger.log(
    '============================================================'
  );

  Logger.log(
    'DIAGNOSTIC TERMINÉ — AUCUNE MODIFICATION'
  );

  Logger.log(
    '============================================================'
  );


  return {

    uploads:
      videosPlaylist.length,

    videosUniques:
      videosUniques.length,

    videosRetournees:
      nombreVideosRetournees,

    videosManquantes:
      videosManquantes

  };

}
